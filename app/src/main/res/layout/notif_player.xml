<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressBackgroundTint="?android:attr/colorControlNormal"
        android:progressTint="?android:attr/colorAccent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/notif_btn_folder_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:contentDescription="@string/player_btn_folder_prev"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="?android:attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/notif_btn_rewind"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:contentDescription="@string/player_btn_notify_rewind"
            android:src="@android:drawable/ic_media_rew"
            android:tint="?android:attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/notif_btn_random"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:contentDescription="@string/player_btn_random"
            android:src="@android:drawable/ic_menu_shuffle"
            android:tint="?android:attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/notif_btn_forward"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:contentDescription="@string/player_btn_notify_forward"
            android:src="@android:drawable/ic_media_ff"
            android:tint="?android:attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/notif_btn_folder_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:contentDescription="@string/player_btn_folder_next"
            android:src="@android:drawable/ic_menu_more"
            android:tint="?android:attr/colorControlNormal" />
    </LinearLayout>
</LinearLayout>
